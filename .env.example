# Copy to .env and fill locally. Do not commit .env or paste keys into chat.
# Used by the default text provider, including scene and thumbnail prompt planning in external-image mode.
OPENROUTER_API_KEY=
# Optional: used only when text_provider is openai.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Only used in image_mode=api: fallback for OpenRouter image credits, or direct image_provider=gemini.
# Supply a JSON array on one line, for example: ["first-key", "second-key"]. Never commit real keys.
# A single key or a comma-separated list is also accepted. Keys are tried in order.
GEMINI_API_KEY=[]
